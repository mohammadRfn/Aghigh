# Managed by Ansible (role app). pgBackRest reads every option from PGBACKREST_* variables: this file is the
# env_file of the postgres service (compose.prod.yml) and of the restore test. Keep it out of the repository.
PGBACKREST_STANZA=aghigh
PGBACKREST_REPO1_PATH={{ backup_repo_path }}
PGBACKREST_REPO1_RETENTION_FULL={{ backup_retention_full }}
PGBACKREST_REPO1_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO1_CIPHER_PASS={{ vault_backup_cipher_pass }}
# If the repository is unreachable, WAL piles up in pg_wal until the disk is full. Above this size pgBackRest
# drops the queue instead (the database keeps running, PITR has a gap until the next backup).
PGBACKREST_ARCHIVE_PUSH_QUEUE_MAX=4GiB
{% if backup_repo_type == 's3' %}
PGBACKREST_REPO1_TYPE=s3
PGBACKREST_REPO1_S3_ENDPOINT={{ backup_s3_endpoint }}
PGBACKREST_REPO1_S3_REGION={{ backup_s3_region }}
PGBACKREST_REPO1_S3_BUCKET={{ backup_s3_bucket }}
PGBACKREST_REPO1_S3_URI_STYLE={{ backup_s3_uri_style }}
PGBACKREST_REPO1_S3_KEY={{ vault_backup_s3_key }}
PGBACKREST_REPO1_S3_KEY_SECRET={{ vault_backup_s3_key_secret }}
{% else %}
PGBACKREST_REPO1_TYPE=sftp
PGBACKREST_REPO1_SFTP_HOST={{ backup_sftp_host }}
PGBACKREST_REPO1_SFTP_HOST_USER={{ backup_sftp_user }}
PGBACKREST_REPO1_SFTP_PRIVATE_KEY_FILE=/etc/pgbackrest/keys/id_backup
PGBACKREST_REPO1_SFTP_HOST_KEY_HASH_TYPE=sha256
{% if backup_sftp_host_fingerprint | length > 0 %}
PGBACKREST_REPO1_SFTP_HOST_FINGERPRINT={{ backup_sftp_host_fingerprint }}
{% endif %}
{% endif %}
