# Catalog Task 4 defaults (configuration, not measurements).
# Prices are integer minor units in this single ISO 4217 catalog currency.
CATALOG_CURRENCY=IRR
# Replace the example CDN origin before deployment; metadata only, no uploads.
CATALOG_IMAGE_BASE_URL=https://cdn.example.com
# Reject per_page above the maximum; never clamp. Maximum cannot exceed 50.
CATALOG_PER_PAGE=20
CATALOG_PER_PAGE_MAX=50
# flexible uses [fresh, TOTAL fresh+stale lifetime], in seconds.
CATALOG_CACHE_FRESH_SECONDS=60
CATALOG_CACHE_STALE_SECONDS=180
# State-store lock lease and acquisition wait, in seconds; tune after measurement.
CATALOG_CACHE_LOCK_SECONDS=15
CATALOG_CACHE_LOCK_WAIT_SECONDS=5
# Must cover Task 5 ordering.max_items; pre-Task-5 safety floor is 100.
CATALOG_PRICING_MAX_IDS=100
# Atomic image replacement and complete category-tree depth bounds.
CATALOG_IMAGES_MAX=10
CATALOG_CATEGORY_MAX_DEPTH=5
# Safe integer upper bound, also inside PostgreSQL signed bigint.
CATALOG_PRICE_MAX_MINOR=9007199254740991

APP_NAME=Aghigh
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Switch BROADCAST_CONNECTION to "reverb" only after filling the REVERB_* values
# (with empty keys the app cannot boot using the reverb driver). In Docker: `make reverb-keys`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=


# --- Identity ---
HASH_DRIVER=argon2id
ARGON_MEMORY=19456
ARGON_TIME=2
ARGON_THREADS=1
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=http://localhost:5173
JWT_ACCESS_TTL=10
JWT_ACTIVE_KID=k1
JWT_PRIVATE_KEY_PATH=storage/jwt/k1.private
JWT_PUBLIC_KEY_PATH=storage/jwt/k1.public
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_VERIFICATION_KEYS={}
REFRESH_REUSE_GRACE_SECONDS=5
REFRESH_IDLE_DAYS=14
REFRESH_ABSOLUTE_DAYS=30
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_BASE_SECONDS=30
AUTH_LOCKOUT_MAX_SECONDS=900
AUTH_RESET_TTL_MINUTES=60
AUTH_FRONTEND_URL=http://localhost:5173

# --- Task 6: queues, Horizon, saga, scheduler (configuration, not measurements) ---
REDIS_QUEUE_RETRY_AFTER=120
QUEUE_LOCK_STORE=state
SCHEDULE_CACHE_DRIVER=state
HORIZON_WORKER_MEMORY=64
HORIZON_ORDERS_MIN_PROCESSES=1
HORIZON_ORDERS_MAX_PROCESSES=4
HORIZON_BROADCASTS_MIN_PROCESSES=1
HORIZON_BROADCASTS_MAX_PROCESSES=2
HORIZON_NOTIFICATIONS_MIN_PROCESSES=1
HORIZON_NOTIFICATIONS_MAX_PROCESSES=2
HORIZON_DEFAULT_MIN_PROCESSES=1
HORIZON_DEFAULT_MAX_PROCESSES=2
ORDERING_SAGA_ENABLED=true
ORDERING_SAGA_BACKOFF_BASE_SECONDS=5
ORDERING_SAGA_BACKOFF_CAP_SECONDS=120
ORDERING_GATEWAY_MAX_EXCEPTIONS=20
ORDERING_GATEWAY_DECAY_SECONDS=60
ORDERING_EXPIRY_BATCH=500
ORDERING_EXPIRY_MAX_BATCHES=20
OUTBOX_RELAY_BATCH=200
PAYMENT_GATEWAY=fake
PAYMENT_FAKE_LATENCY_MIN_MS=50
PAYMENT_FAKE_LATENCY_MAX_MS=250
PAYMENT_FAKE_FAILURE_RATE=0.02
PAYMENT_FAKE_TIMEOUT_RATE=0.01
PAYMENT_FAKE_TIMEOUT_MS=3000
PAYMENT_FAKE_SEED=
PAYMENT_WEBHOOK_SECRET=change_me_webhook_secret
PAYMENT_WEBHOOK_SECRET_PREVIOUS=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# ---- Task 7: rate limiting (append to BOTH .env.example and .env.docker.example; copy into your .env.docker)
# Comma-separated IPs/CIDRs allowed to set X-Forwarded-*. Default (unset) = the compose edge network where only
# Traefik lives (compose.yaml networks.edge.ipam). Never "*" unless the app port is unreachable directly.
TRUSTED_PROXIES=172.30.0.0/24
# redis (production) | memory (test double; refused outside local/testing/loadtest)
RATE_LIMIT_SLIDING_DRIVER=redis
# Scale every limit (ceil(limit x factor), never 0). ONLY honoured in local/testing/loadtest; boot FAILS elsewhere.
# Leave empty in production. Load tests: RATE_LIMIT_MULTIPLIER=20 (APP_ENV=loadtest).
RATE_LIMIT_MULTIPLIER=
RATE_LIMIT_SLIDING_MAX_LIMIT=1000
RATE_LIMIT_LOG_SAMPLE_AFTER=20
RATE_LIMIT_LOG_SAMPLE_EVERY=100
# Per-limiter values (requests per 60s window). Task 3 names kept.
AUTH_LOGIN_RATE=10
AUTH_REGISTER_RATE=5
AUTH_FORGOT_RATE=5
AUTH_RESEND_RATE=5
AUTH_REFRESH_RATE=30
ORDERS_IP_RATE=120
ORDERS_USER_RATE=30
CHAT_MESSAGES_RATE=60
CATALOG_PUBLIC_RATE=300
ADMIN_RATE=120
WEBHOOK_RATE=600
BROADCASTING_AUTH_RATE=60
# Concurrency cap on POST /orders per user and its slot expiry (must exceed the longest request).
ORDERS_CONCURRENCY_MAX=2
ORDERS_CONCURRENCY_TTL_MS=30000
# Business limit inside PlaceOrder (attempts per user per minute; replays are free, 409s count).
ORDERS_PER_MINUTE_PER_USER=10

# --- Task 8: Reverb / chat ---
# Server-side publishing (app/horizon -> Reverb HTTP API, backend network). Never the browser address.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Client address (browsers / k6 through Traefik on :8000, path /app). Task 11 switches these to https/443.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8000
VITE_REVERB_SCHEME=http
# Hosts allowed in the WebSocket Origin header (Reverb compares the HOST only, Str::is wildcards).
# Empty = hosts of CORS_ALLOWED_ORIGINS.
REVERB_ALLOWED_ORIGINS=
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none
# Per Reverb INSTANCE (not global with REVERB_SCALE > 1). Empty = unlimited.
REVERB_APP_MAX_CONNECTIONS=
# 2000 Persian chars ~ 14 000 bytes on the publish request (docs/chat-protocol.md "Size arithmetic").
REVERB_MAX_REQUEST_SIZE=32768
REVERB_APP_MAX_MESSAGE_SIZE=32768
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_APP_PING_INTERVAL=60
# Replicas share events through Redis pub/sub (REDIS_HOST/REDIS_DB = redis-queue db 0). Needed when REVERB_SCALE > 1.
REVERB_SCALING_ENABLED=true
REVERB_SCALING_CHANNEL=reverb
CHAT_STATE_DRIVER=redis
CHAT_BODY_MAX_CHARS=2000
CHAT_MESSAGES_DEFAULT_LIMIT=50
CHAT_PER_PAGE=20
CHAT_PER_PAGE_MAX=50
CHAT_PRESENCE_TTL_SECONDS=60
CHAT_UNREAD_TTL_SECONDS=300
# 0 = no cap on open conversations per support agent.
CHAT_AGENT_MAX_OPEN=0
CHAT_CLAIM_ATTEMPTS=5
CHAT_SWEEP_CHUNK=500
CHAT_TYPING_RATE=60
CHAT_HEARTBEAT_RATE=12
CHAT_READ_RATE=120
CHAT_CLAIM_RATE=60
# Approximate per-user socket cap at channel auth (multiplier applies) and the slot lifetime without heartbeat.
CHAT_CONNECTIONS_PER_USER=5
CHAT_CONNECTION_TTL_MS=120000

# --- Task 9: observability (configuration, not measurements; docs/observability.md, ADR 0010) ---
# App metrics. METRICS_ENABLED=false selects the null driver (Task 10 measures the overhead on/off).
METRICS_ENABLED=true
# redis (default outside tests) | memory (tests only: per process) | null
METRICS_DRIVER=redis
# Bearer token of GET /internal/metrics; EMPTY = endpoint disabled (404). `make obs-keys` fills it and writes the
# same value to docker/observability/secrets/metrics_token for Prometheus.
METRICS_TOKEN=
# Dedicated metrics db on redis-queue (noeviction). Never the state db (2). make test-int uses 13.
REDIS_METRICS_DB=3
METRICS_QUEUE_CACHE_SECONDS=5
METRICS_REVERB_CACHE_SECONDS=10
METRICS_REVERB_TIMEOUT_SECONDS=1
# Errors -> GlitchTip (Sentry SDK). Empty DSN = no-op. In-container host is glitchtip:8000 (backend network), e.g.
# SENTRY_LARAVEL_DSN=http://<public_key>@glitchtip:8000/1  (copy the key from the GlitchTip project DSN).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Release tag for GlitchTip: set GIT_SHA at build/deploy (e.g. GIT_SHA=$(git rev-parse --short HEAD)); empty = none.
GIT_SHA=
