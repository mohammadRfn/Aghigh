# Task 11: pgBackRest repository settings = env_file of the postgres service in compose.prod.yml and of
# scripts/backup/restore-test.sh. On the server it is /opt/aghigh/shared/.env.pgbackrest (Ansible role app, vault).
# Copy to .env.pgbackrest only for a local `docker compose config`; never commit real values.
# The repository is OFF-server and encrypted. Losing PGBACKREST_REPO1_CIPHER_PASS = losing every backup.
PGBACKREST_STANZA=aghigh
PGBACKREST_REPO1_PATH=/aghigh
PGBACKREST_REPO1_RETENTION_FULL=4
PGBACKREST_REPO1_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO1_CIPHER_PASS=change_me_backup_passphrase
PGBACKREST_ARCHIVE_PUSH_QUEUE_MAX=4GiB

# --- S3-compatible target (default) ---
PGBACKREST_REPO1_TYPE=s3
PGBACKREST_REPO1_S3_ENDPOINT=s3.example.com
PGBACKREST_REPO1_S3_REGION=us-east-1
PGBACKREST_REPO1_S3_BUCKET=aghigh-backups
PGBACKREST_REPO1_S3_URI_STYLE=path
PGBACKREST_REPO1_S3_KEY=change_me_access_key
PGBACKREST_REPO1_S3_KEY_SECRET=change_me_secret_key

# --- SFTP target (instead of the S3 block; key file is mounted from /opt/aghigh/shared/pgbackrest) ---
# PGBACKREST_REPO1_TYPE=sftp
# PGBACKREST_REPO1_SFTP_HOST=backup.example.com
# PGBACKREST_REPO1_SFTP_HOST_USER=aghigh
# PGBACKREST_REPO1_SFTP_PRIVATE_KEY_FILE=/etc/pgbackrest/keys/id_backup
# PGBACKREST_REPO1_SFTP_HOST_KEY_HASH_TYPE=sha256
# PGBACKREST_REPO1_SFTP_HOST_FINGERPRINT=
