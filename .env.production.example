# Task 11: production environment EXAMPLE. No real secret belongs in this file.
# On the server the real file is /opt/aghigh/shared/.env.production (mode 600), rendered by Ansible from the vault
# (ansible/roles/app/templates/env.production.j2 has the same keys). For a local check of the merged model:
#   cp .env.production.example .env.production && cp .env.pgbackrest.example .env.pgbackrest && make prod-config
# It is BOTH the compose --env-file (interpolation) and the env_file of the PHP containers.
# --- Task 11: deploy, edge and images (read by compose.prod.yml and scripts/deploy) ---
APP_NAME=Aghigh
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Comma-separated OLD keys, kept while data encrypted with them may still exist (docs/runbook.md "Rotate secrets").
APP_PREVIOUS_KEYS=
APP_URL=https://aghigh.example.com
# A real domain is mandatory: Let's Encrypt does not issue for a bare IP.
APP_DOMAIN=aghigh.example.com
ACME_EMAIL=ops@example.com
# Rehearsal with the staging CA: ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory and ACME_STORAGE_FILE=acme-staging.json
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
ACME_STORAGE_FILE=acme.json
# Mirror for every third-party image; keep the trailing slash (same convention as compose.yaml), empty = Docker Hub.
REGISTRY_PREFIX=
APP_IMAGE_REPO=ghcr.io/mohammadrfn/aghigh-app
# Overridden by the deploy script with the git SHA being deployed; the value here is only a placeholder.
APP_IMAGE_TAG=0000000000000000000000000000000000000000
# Built by .github/workflows/postgres-image.yml; changing it recreates Postgres (not zero-downtime).
POSTGRES_BACKUP_IMAGE=ghcr.io/mohammadrfn/aghigh-postgres:18-pgbackrest-1
# Horizon dashboard: only through the Traefik admin entrypoint on 127.0.0.1:ADMIN_PORT (SSH tunnel). Empty = closed.
HORIZON_ADMIN_TOKEN=change_me_horizon_admin_token
ADMIN_PORT=8081
# Must stay empty in production: the app refuses to boot otherwise (compose.prod.yml forces it as well).
RATE_LIMIT_MULTIPLIER=
# = networks.edge.ipam in compose.yaml (compose.prod.yml forces it, verify-compose.sh compares both).
TRUSTED_PROXIES=172.30.0.0/24
SESSION_DRIVER=array
# --- real SMTP provider (no Mailpit in production) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change_me_smtp_user
MAIL_PASSWORD=change_me_smtp_password
MAIL_FROM_ADDRESS=no-reply@aghigh.example.com
MAIL_FROM_NAME=Aghigh
# --- Sentry/GlitchTip transport: short timeouts so an unreachable DSN cannot hold a request (config/sentry.php) ---
SENTRY_HTTP_CONNECT_TIMEOUT=1.0
SENTRY_HTTP_TIMEOUT=2.0
GLITCHTIP_EMAIL_URL=consolemail://
# --- everything below: the keys of .env.example + .env.docker.example with production values ---
# REVERB_HOST/PORT/SCHEME are the SERVER-side publishing target (reverb:8080 over http on the backend network).
# Clients use VITE_REVERB_* = the public domain, 443, https (wss through Traefik).
# PAYMENT_GATEWAY=fake is the only gateway that exists: it declines PAYMENT_FAKE_FAILURE_RATE of charges by design.
CATALOG_CURRENCY=IRR
CATALOG_IMAGE_BASE_URL=https://cdn.example.com
CATALOG_PER_PAGE=20
CATALOG_PER_PAGE_MAX=50
CATALOG_CACHE_FRESH_SECONDS=60
CATALOG_CACHE_STALE_SECONDS=180
CATALOG_CACHE_LOCK_SECONDS=15
CATALOG_CACHE_LOCK_WAIT_SECONDS=5
CATALOG_PRICING_MAX_IDS=100
CATALOG_IMAGES_MAX=10
CATALOG_CATEGORY_MAX_DEPTH=5
CATALOG_PRICE_MAX_MINOR=9007199254740991
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=app
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=redis-queue
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
VITE_APP_NAME="${APP_NAME}"
REVERB_APP_ID=change_me_reverb_id
REVERB_APP_KEY=change_me_reverb_key
REVERB_APP_SECRET=change_me_reverb_secret
HASH_DRIVER=argon2id
ARGON_MEMORY=19456
ARGON_TIME=2
ARGON_THREADS=1
JWT_ISSUER=https://aghigh.example.com
JWT_AUDIENCE=https://app.example.com
JWT_ACCESS_TTL=10
JWT_ACTIVE_KID=k1
JWT_PRIVATE_KEY_PATH=storage/jwt/k1.private
JWT_PUBLIC_KEY_PATH=storage/jwt/k1.public
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_VERIFICATION_KEYS={}
