# Task 10: loadtest settings for the app containers. Copy to .env.loadtest (git-ignored): `make loadtest-init`.
# Read ONLY by compose.loadtest.yaml, i.e. only by the loadtest make targets (make loadtest-up, make k6-<scenario>).
# It overrides .env.docker; per-run switches (strategy, metrics on/off) are written by run-scenario.sh into
# .env.loadtest.variant and override this file for that run. Every value here is configuration, not a measurement.

# Enables /api/v1/_bench/* and /api/v1/_debug/*, loadtest:seed-users, the naive stock strategy and the multiplier.
# Production refuses all of them (tests: BenchRoutesTest, DebugRoutesTest, StockStrategyBootTest, LoadtestSeedUsersTest).
APP_ENV=loadtest
APP_DEBUG=false
# Debug logging costs I/O on every request. The `security` channel logs at info regardless of this.
LOG_LEVEL=warning

# All k6 traffic comes from ONE IP, so per-IP limiters would be the first thing measured. 20 scales every limit
# (e.g. public-catalog 300/min -> 6000/min = 100 rps). Raise it for higher rates. The auth-abuse scenario unsets it.
RATE_LIMIT_MULTIPLIER=20

# Default strategy for every scenario except order-flood, which sets naive | atomic | locking per variant.
STOCK_STRATEGY=atomic
# Only meaningful with STOCK_STRATEGY=naive (widens the read->write window). Keep 0 here; run-scenario.sh sets it
# for the naive variant (NAIVE_DELAY_MS, default 50).
STOCK_NAIVE_DELAY_MS=0

# metrics-overhead flips these two per variant (metrics-off / metrics-on / traces-on).
METRICS_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.0

# REVERB_SCALE is NOT a container variable: it is the number of Reverb replicas and is passed to make, e.g.
#   REVERB_SCALE=2 make loadtest-up        make k6-websocket-chat MODE=fanout REVERB_SCALE=2
# REVERB_SCALE=1
