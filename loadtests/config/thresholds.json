{
  "schema_version": 1,
  "_readme": [
    "Every number under `thresholds` is PROVISIONAL configuration, not a measurement, until its entry says status=baseline.",
    "Provisional p95 budgets reuse the only budget that already exists in the repo: 500 ms (loadtests/smoke.js and the",
    "AghighHttpP95LatencyHigh alert rule) and 2000 ms for chat delivery (loadtests/chat-smoke.js DELIVERY_MS).",
    "Provisional error-rate budget = 1% (loadtests/smoke.js).",
    "After a baseline: set status to baseline, fill baseline.date (UTC, YYYY-MM-DD) and baseline.commit (git SHA of the",
    "run), and replace the numbers with ones derived from the 3-run median. See loadtests/README.md \"Calibration\".",
    "`assertions` are correctness conditions, not budgets: they are always enforced and never calibrated."
  ],
  "scenarios": {
    "catalog": {
      "status": "provisional",
      "baseline": {
        "date": null,
        "commit": null
      },
      "thresholds": {
        "http_req_duration{phase:main}": [
          "p(95)<500"
        ],
        "http_req_failed{phase:main}": [
          "rate<0.01"
        ]
      },
      "assertions": {
        "lt_http_5xx": [
          "count==0"
        ]
      },
      "variants": {
        "naive": {
          "status": "provisional",
          "baseline": {
            "date": null,
            "commit": null
          },
          "_note": "The naive endpoint is expected to be slower; its budget stays the same provisional number until measured so the result shows by how much it misses."
        }
      }
    },
    "order-flood": {
      "status": "provisional",
      "baseline": {
        "date": null,
        "commit": null
      },
      "thresholds": {
        "http_req_duration{phase:main}": [
          "p(95)<500"
        ],
        "lt_unexpected_response{phase:main}": [
          "rate<0.01"
        ]
      },
      "assertions": {
        "lt_orders_replay_mismatch": [
          "count==0"
        ],
        "lt_orders_double_created": [
          "count==0"
        ],
        "lt_orders_other": [
          "count==0"
        ],
        "lt_http_429": [
          "count==0"
        ],
        "lt_http_5xx": [
          "count==0"
        ]
      },
      "variants": {
        "naive": {
          "_note": "Expected to oversell. Nothing is asserted from k6: after-run.sh --expect-violations asserts violation_count > 0.",
          "assertions": {}
        }
      }
    },
    "spike": {
      "status": "provisional",
      "baseline": {
        "date": null,
        "commit": null
      },
      "thresholds": {
        "http_req_duration{phase:baseline}": [
          "p(95)<500"
        ],
        "http_req_duration{phase:recovery}": [
          "p(95)<500"
        ],
        "lt_unexpected_response{phase:baseline}": [
          "rate<0.01"
        ],
        "lt_unexpected_response{phase:recovery}": [
          "rate<0.01"
        ]
      },
      "assertions": {}
    },
    "soak": {
      "status": "provisional",
      "baseline": {
        "date": null,
        "commit": null
      },
      "thresholds": {
        "http_req_duration{phase:main}": [
          "p(95)<500"
        ],
        "lt_unexpected_response{phase:main}": [
          "rate<0.01"
        ]
      },
      "assertions": {
        "lt_auth_failures": [
          "count==0"
        ]
      }
    },
    "websocket-chat": {
      "status": "provisional",
      "baseline": {
        "date": null,
        "commit": null
      },
      "thresholds": {},
      "assertions": {},
      "variants": {
        "ceiling": {
          "thresholds": {
            "lt_ws_handshake_ms": [
              "p(95)<2000"
            ]
          }
        },
        "fanout": {
          "thresholds": {
            "lt_ws_delivery_ms": [
              "p(95)<2000"
            ],
            "lt_ws_delivery_missed": [
              "rate<0.01"
            ],
            "http_req_duration{phase:main}": [
              "p(95)<500"
            ]
          },
          "assertions": {
            "lt_http_5xx": [
              "count==0"
            ]
          }
        },
        "reconnect": {
          "thresholds": {
            "lt_ws_recover_ms": [
              "p(95)<30000"
            ],
            "lt_ws_unrecovered": [
              "rate<0.01"
            ]
          },
          "_note": "30000 ms = the documented reconnect back-off cap (docs/chat-protocol.md, RECONNECT_CAP_MS); provisional."
        }
      }
    },
    "auth-abuse": {
      "status": "provisional",
      "baseline": {
        "date": null,
        "commit": null
      },
      "thresholds": {
        "http_req_duration{phase:stuffing}": [
          "p(95)<500"
        ],
        "lt_unexpected_response": [
          "rate<0.01"
        ]
      },
      "assertions": {
        "lt_http_5xx": [
          "count==0"
        ],
        "lt_auth_limit_mismatch": [
          "count==0"
        ],
        "lt_auth_xff_trusted": [
          "count==0"
        ],
        "lt_auth_lockout_mismatch": [
          "count==0"
        ],
        "lt_auth_stuffing_success": [
          "count==0"
        ]
      }
    },
    "metrics-overhead": {
      "status": "provisional",
      "baseline": {
        "date": null,
        "commit": null
      },
      "thresholds": {
        "http_req_duration{phase:main}": [
          "p(95)<500"
        ],
        "lt_unexpected_response{phase:main}": [
          "rate<0.01"
        ]
      },
      "assertions": {}
    }
  }
}
