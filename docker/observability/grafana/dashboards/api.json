    {
      "type": "stat",
      "title": "5xx ratio (5m)",
      "description": "Alert AghighHttp5xxRateHigh fires above 2% for 5m (provisional).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
