    {
      "type": "timeseries",
      "title": "POST /orders latency p50/p95/p99 (route ordering.orders.store)",
      "description": "Includes the idempotency lookup, the pg_advisory_xact_lock and stock reservation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(aghigh_http_request_duration_seconds_bucket{route=\"ordering.orders.store\"}[$__rate_interval])))",
