{
  "uid": "aghigh-websocket",
  "title": "Aghigh / WebSocket (Reverb + Chat)",
  "description": "WHAT THE CONNECTION PANEL MEANS: reverb_pusher_api_connections is what Reverb's Pusher API (GET /apps/{id}/connections) reports. In Reverb 1.12.0 that is the ChannelManager's connection list, i.e. sockets that joined at least one channel, merged across replicas when scaling is enabled. Task 8 observed 5 reported vs 19 ESTABLISHED sockets. It is NOT a socket count; per-replica sockets come only from cAdvisor TCP series (if present) or /proc/net/tcp inside each replica (make verify-chat step 3).",
  "tags": [
    "aghigh",
    "task-9"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "request_id",
        "label": "request_id (for Loki data links)",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "aghigh"
      ],
      "asDropdown": true,
      "title": "Aghigh dashboards",
      "includeVars": true,
      "keepTime": true
    }
  ],
