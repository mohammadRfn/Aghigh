{
  "uid": "aghigh-queues",
  "title": "Aghigh / Queues",
  "description": "Answers: how deep is each queue, how old is the oldest pending job (EXACT) versus Horizon's wait ESTIMATE (two different gauges on purpose), how long do jobs wait before pickup (the Task 8 broadcast delay) and run, what fails. Depth gauges come from QueueMetrics::snapshot() at scrape time (cached 5 s).",
  "tags": [
    "aghigh",
    "task-9"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "request_id",
        "label": "request_id (for Loki data links)",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "aghigh"
      ],
      "asDropdown": true,
      "title": "Aghigh dashboards",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
