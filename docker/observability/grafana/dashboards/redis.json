{
  "uid": "aghigh-redis",
  "title": "Aghigh / Redis",
  "description": "Answers: how close is redis-queue (noeviction: writes FAIL at 100%) to its 300 MB maxmemory, how many keys per db (db0 queues/Reverb, db2 state, db3 metrics), is redis-cache evicting, which app component sees state-store errors. Memory is per INSTANCE, keyspace per db.",
  "tags": [
    "aghigh",
    "task-9"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
