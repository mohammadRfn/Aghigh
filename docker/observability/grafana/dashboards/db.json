{
  "uid": "aghigh-db",
  "title": "Aghigh / DB",
  "description": "Answers: is PgBouncer's transaction pool saturated (clients waiting?), how close is Postgres to max_connections, is the cache hit ratio healthy, are there deadlocks/locks, which queries are slow (slow_query channel in Loki). postgres_exporter connects DIRECTLY as aghigh_monitor (pg_monitor).",
  "tags": [
    "aghigh",
    "task-9"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "request_id",
        "label": "request_id (for Loki data links)",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "aghigh"
      ],
      "asDropdown": true,
      "title": "Aghigh dashboards",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
