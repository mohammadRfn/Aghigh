--- /dev/null
+++ b/docker/observability/loki/loki.yml
@@ -0,0 +1,74 @@
+# Task 9: Loki single binary, filesystem storage, TSDB v13. Retention and ingestion limits are explicit and
+# provisional (env through -config.expand-env=true, defaults in compose.yaml). Telemetry off.
+auth_enabled: false
+
+server:
+  http_listen_address: 0.0.0.0
+  http_listen_port: 3100
+  grpc_listen_port: 9096
+  log_level: warn
+
+common:
+  instance_addr: 127.0.0.1
+  path_prefix: /loki
+  storage:
+    filesystem:
+      chunks_directory: /loki/chunks
+      rules_directory: /loki/rules
+  replication_factor: 1
+  ring:
+    kvstore:
+      store: inmemory
+
+schema_config:
+  configs:
+    - from: "2024-04-01"
+      store: tsdb
+      object_store: filesystem
+      schema: v13
+      index:
+        prefix: index_
+        period: 24h
+
+limits_config:
+  # provisional: one week of dev logs
+  retention_period: ${LOKI_RETENTION_PERIOD:-168h}
+  ingestion_rate_mb: ${LOKI_INGESTION_RATE_MB:-4}
+  ingestion_burst_size_mb: ${LOKI_INGESTION_BURST_MB:-8}
+  max_streams_per_user: 1000           # labels are service x channel x level only (ADR: docs/observability.md)
+  max_line_size: 262144
+  max_line_size_truncate: true
+  reject_old_samples: true
+  reject_old_samples_max_age: 168h
+  allow_structured_metadata: true      # request_id travels as structured metadata, never as a label
+  volume_enabled: true
+  max_query_series: 500
+  max_entries_limit_per_query: 5000
+
+compactor:
+  working_directory: /loki/compactor
+  retention_enabled: true
+  delete_request_store: filesystem
+  compaction_interval: 10m
+  retention_delete_delay: 2h
+  retention_delete_worker_count: 50
+
+ingester:
+  chunk_idle_period: 5m
+  chunk_retain_period: 30s
+  wal:
+    enabled: true
+    dir: /loki/wal
+
+query_range:
+  results_cache:
+    cache:
+      embedded_cache:
+        enabled: true
+        max_size_mb: 64
+
+pattern_ingester:
+  enabled: false
+
+analytics:
+  reporting_enabled: false
diff --git a/docker/observability/prometheus/prometheus.yml b/docker/observability/prometheus/prometheus.yml
new file mode 100644
index 0000000..9a15b54
--- /dev/null
+++ b/docker/observability/prometheus/prometheus.yml
@@ -0,0 +1,75 @@
+# Task 9. Scrape interval 15 s; retention by time AND size is set on the command line (compose.yaml, provisional).
+# Every target is a compose service name: Prometheus joins `backend` (exporters, app) and `edge` (traefik:8082).
+global:
+  scrape_interval: 15s
+  scrape_timeout: 10s
+  evaluation_interval: 15s
+  external_labels:
+    stack: aghigh-dev
+
+rule_files:
+  - /etc/prometheus/rules/aghigh.rules.yml
+
+# No Alertmanager in dev: alerts are evaluated and visible here and in Grafana only (Task 11 decides notification).
+
+scrape_configs:
+  - job_name: app
+    metrics_path: /internal/metrics
+    scheme: http
+    # Bearer token = METRICS_TOKEN, written by `make obs-keys` (git-ignored). The scrape goes to app:8000 on the
+    # backend network; through Traefik the same path is denied (make obs-verify proves both).
+    authorization:
+      type: Bearer
+      credentials_file: /etc/prometheus/secrets/metrics_token
+    static_configs:
+      - targets: ["app:8000"]
+
+  - job_name: traefik
+    static_configs:
+      - targets: ["traefik:8082"]
+
+  - job_name: prometheus
+    static_configs:
+      - targets: ["localhost:9090"]
+
+  - job_name: node
+    static_configs:
+      - targets: ["node-exporter:9100"]
+
+  - job_name: cadvisor
+    scrape_timeout: 10s
+    static_configs:
+      - targets: ["cadvisor:8080"]
+    metric_relabel_configs:
+      # keep only compose-managed containers; drop the noisy per-cgroup root series
+      - source_labels: [__name__, container_label_com_docker_compose_project]
+        regex: "container_.*;"
+        action: drop
+
+  - job_name: postgres
+    static_configs:
+      - targets: ["postgres-exporter:9187"]
+
+  - job_name: pgbouncer
+    static_configs:
+      - targets: ["pgbouncer-exporter:9127"]
+
+  - job_name: redis-queue
+    static_configs:
+      - targets: ["redis-exporter-queue:9121"]
+
+  - job_name: redis-cache
+    static_configs:
+      - targets: ["redis-exporter-cache:9121"]
+
+  - job_name: loki
+    static_configs:
+      - targets: ["loki:3100"]
+
+  - job_name: alloy
+    static_configs:
+      - targets: ["alloy:12345"]
+
+  - job_name: grafana
+    static_configs:
+      - targets: ["grafana:3000"]
diff --git a/docker/observability/prometheus/rules/aghigh.rules.test.yml b/docker/observability/prometheus/rules/aghigh.rules.test.yml
