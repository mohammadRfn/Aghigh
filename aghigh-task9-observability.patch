+  echo "## alerts (state)"; curl -s "$PROM/api/v1/alerts" | tr '{' '\n' | grep -oE '"alertname":"[^"]+"|"state":"[^"]+"' | paste - - | sort | uniq -c
+} > docs/perf/obs-inventory.txt 2>&1 || true
