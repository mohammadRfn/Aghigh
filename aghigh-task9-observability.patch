diff --git a/scripts/obs-keys.sh b/scripts/obs-keys.sh
new file mode 100755
index 0000000..c1cc386
--- /dev/null
+++ b/scripts/obs-keys.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+# Task 9 (dev only): fill EMPTY observability secrets in .env.docker with random values (same pattern as
+# scripts/reverb-keys.sh: existing non-empty values are never touched, re-running is safe) and write the metrics
+# bearer token to docker/observability/secrets/metrics_token for Prometheus (git-ignored, must equal METRICS_TOKEN).
+set -euo pipefail
+FILE="${1:-.env.docker}"
+SECRET_DIR="docker/observability/secrets"
+[ -f "$FILE" ] || { echo "missing $FILE (run make init)"; exit 1; }
+[ -z "$(tail -c1 "$FILE")" ] || echo >> "$FILE"   # glue guard: end the last line before appending
+if grep -qE '^APP_ENV=("|)?production' "$FILE"; then
+  echo "refusing: $FILE has APP_ENV=production (generate real secrets with your secret manager)"; exit 1
+fi
+rand_hex() { od -An -N"$1" -tx1 /dev/urandom | tr -d ' \n'; }
+# Letters and digits only for Postgres passwords: they are interpolated into SQL by 02-observability-roles.sh.
+rand_alnum() { LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c "$1"; }
+fill() {
+  local name="$1" value="$2"
+  if grep -qE "^${name}=(\"\"|'')?\s*$" "$FILE"; then
+    sed -i.bak -E "s|^${name}=.*$|${name}=${value}|" "$FILE" && rm -f "$FILE.bak"
+    echo "set ${name}"
+  elif ! grep -qE "^${name}=" "$FILE"; then
+    printf '%s=%s\n' "$name" "$value" >> "$FILE"
+    echo "added ${name}"
+  else
+    echo "kept ${name} (already set)"
+  fi
+}
+fill METRICS_TOKEN "$(rand_hex 32)"
+fill GRAFANA_ADMIN_PASSWORD "$(rand_alnum 24)"
+fill GLITCHTIP_SECRET_KEY "$(rand_hex 32)"
+fill GLITCHTIP_DB_PASSWORD "$(rand_alnum 24)"
+fill DB_MONITOR_PASSWORD "$(rand_alnum 24)"
+
+# Prometheus reads the token from a file (authorization.credentials_file). Mode 0644: the container runs as
+# `nobody` and a bind mount keeps host permissions (dev-only secret, directory is git-ignored).
+mkdir -p "$SECRET_DIR"
+token="$(grep -E '^METRICS_TOKEN=' "$FILE" | tail -1 | cut -d= -f2- | tr -d '"' | tr -d "'")"
+printf '%s' "$token" > "$SECRET_DIR/metrics_token"
+chmod 0644 "$SECRET_DIR/metrics_token"
+echo "wrote $SECRET_DIR/metrics_token (same value as METRICS_TOKEN)"
+echo "Next: make monitoring-role (existing Postgres volume), then recreate the containers that read .env.docker:"
+echo "  docker compose --env-file .env.docker up -d --force-recreate app horizon reverb scheduler"
+echo "  make obs-up"
diff --git a/scripts/obs-query-check.php b/scripts/obs-query-check.php
new file mode 100644
index 0000000..57ea25c
--- /dev/null
+++ b/scripts/obs-query-check.php
@@ -0,0 +1,114 @@
+<?php
+
+declare(strict_types=1);
+
+/*
+ | Task 9 (runs INSIDE the app container: it needs PHP and the backend network, where Prometheus lives).
+ | Extracts every PromQL query from the provisioned dashboards and the alert rules, runs each one against
+ | Prometheus (instant query, now) and prints the empty ones. Empty is only allowed for queries matched by
+ | docker/observability/verify-allowlist.txt (regex | reason). Loki panels are skipped (LogQL, not PromQL).
+ | Exit 1 when a non-allowlisted query is empty, when a query errors, or when nothing could be extracted.
+ */
+
+$root = dirname(__DIR__);
+$prometheus = getenv('PROMETHEUS_URL') ?: 'http://prometheus:9090';
+$dashboards = glob($root.'/docker/observability/grafana/dashboards/*.json') ?: [];
+$rules = glob($root.'/docker/observability/prometheus/rules/*.rules.yml') ?: [];
+$allowlistFile = $root.'/docker/observability/verify-allowlist.txt';
+
+/** @var array<int, array{regex: string, reason: string}> $allowlist */
+$allowlist = [];
+foreach (file($allowlistFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $line) {
+    if (str_starts_with(trim($line), '#')) {
+        continue;
+    }
+    [$regex, $reason] = array_pad(array_map('trim', explode(' | ', $line, 2)), 2, '(no reason given)');
+    $allowlist[] = ['regex' => $regex, 'reason' => $reason];
+}
+
+/** @var array<string, string> $queries expr => origin */
+$queries = [];
+foreach ($dashboards as $file) {
+    $json = json_decode((string) file_get_contents($file), true);
+    if (! is_array($json)) {
+        fwrite(STDERR, "cannot parse {$file}\n");
+        exit(1);
+    }
+    $walk = function (array $panels) use (&$walk, &$queries, $file): void {
+        foreach ($panels as $panel) {
+            foreach ($panel['panels'] ?? [] as $nested) {
+                $walk([$nested]);
+            }
+            $datasource = $panel['datasource']['uid'] ?? 'prometheus';
+            foreach ($panel['targets'] ?? [] as $target) {
+                $uid = $target['datasource']['uid'] ?? $datasource;
+                if ($uid !== 'prometheus' || ! isset($target['expr'])) {
+                    continue;
+                }
+                $queries[(string) $target['expr']] = basename($file).' / '.($panel['title'] ?? '?');
+            }
+        }
+    };
+    $walk($json['panels'] ?? []);
+}
+foreach ($rules as $file) {
+    foreach (file($file) ?: [] as $line) {
+        if (preg_match('/^\s*expr:\s*(.+?)\s*$/', $line, $m) === 1) {
+            $queries[trim($m[1], '"\'')] = basename($file);
+        }
+    }
+}
+if ($queries === []) {
+    fwrite(STDERR, "no queries extracted\n");
+    exit(1);
+}
+
+$substitute = static fn (string $expr): string => str_replace(
+    ['$__rate_interval', '$__interval', '${request_id}', '$request_id'],
+    ['5m', '1m', 'none', 'none'],
+    $expr,
+);
+
+$empty = [];
+$errors = [];
+$ok = 0;
+foreach ($queries as $expr => $origin) {
+    $url = $prometheus.'/api/v1/query?query='.rawurlencode($substitute($expr));
+    $context = stream_context_create(['http' => ['timeout' => 15, 'ignore_errors' => true]]);
+    $raw = @file_get_contents($url, false, $context);
+    $body = is_string($raw) ? json_decode($raw, true) : null;
+    if (! is_array($body) || ($body['status'] ?? '') !== 'success') {
+        $errors[] = sprintf("%s\n    %s\n    -> %s", $origin, $expr, is_array($body) ? ($body['error'] ?? 'error') : 'no answer from '.$prometheus);
+
+        continue;
+    }
+    $result = $body['data']['result'] ?? [];
+    if ($result === []) {
+        $empty[] = [$expr, $origin];
+    } else {
+        $ok++;
+    }
+}
+
+printf("queries: %d total, %d non-empty, %d empty, %d errors\n", count($queries), $ok, count($empty), count($errors));
+$failed = false;
+foreach ($empty as [$expr, $origin]) {
+    $reason = null;
+    foreach ($allowlist as $entry) {
+        if (@preg_match('/'.$entry['regex'].'/', $expr) === 1) {
+            $reason = $entry['reason'];
+            break;
+        }
+    }
+    if ($reason !== null) {
+        printf("  EMPTY (allowed: %s)\n    %s\n    %s\n", $reason, $origin, $expr);
+    } else {
+        $failed = true;
+        printf("  EMPTY (NOT allowed)\n    %s\n    %s\n", $origin, $expr);
+    }
+}
+foreach ($errors as $error) {
+    $failed = true;
+    echo "  ERROR {$error}\n";
+}
+exit($failed ? 1 : 0);
diff --git a/scripts/obs-verify.sh b/scripts/obs-verify.sh
new file mode 100755
index 0000000..3466cbd
--- /dev/null
+++ b/scripts/obs-verify.sh
@@ -0,0 +1,103 @@
+#!/usr/bin/env bash
+# Task 9: verify the observability profile against the REAL stack (like verify-chat.sh). Steps:
+#   1. Grafana answers, provisioning produced no error, the 6 dashboards and 2 datasources exist.
+#   2. /internal/* is denied at the edge (Traefik), with AND without a valid token; Prometheus (backend) reaches
+#      app:8000/internal/metrics with the token; the app target is up in Prometheus.
+#   3. Traffic burst: make k6 s=smoke + make verify-chat (skip with OBS_SKIP_TRAFFIC=1), then one scrape interval.
+#   4. Every PromQL query of dashboards + rules runs against Prometheus; empty only if allowlisted (with a reason).
+#   5. Inventory of what this host really exposes (cAdvisor/node series, reverb TCP series, one Traefik access-log
+#      line, one app log line with request_id) -> docs/perf/obs-inventory.txt, for the docs' "verified" statements.
+#   6. Rules are loaded and healthy.
+set -euo pipefail
+DC="docker compose --env-file .env.docker"
+OBS="$DC --profile observability"
+env_get() { grep -E "^$1=" .env.docker | tail -1 | cut -d= -f2- | tr -d '"' | tr -d "'" || true; }
+GRAFANA_PORT="$(env_get GRAFANA_PORT)"; GRAFANA_PORT="${GRAFANA_PORT:-3000}"
+PROM_PORT="$(env_get PROMETHEUS_PORT)"; PROM_PORT="${PROM_PORT:-9090}"
+HTTP_PORT="$(env_get HTTP_PORT)"; HTTP_PORT="${HTTP_PORT:-8000}"
+GRAFANA="http://127.0.0.1:${GRAFANA_PORT}"
+PROM="http://127.0.0.1:${PROM_PORT}"
+EDGE="http://localhost:${HTTP_PORT}"
+ADMIN_PW="$(env_get GRAFANA_ADMIN_PASSWORD)"
+TOKEN="$(env_get METRICS_TOKEN)"
+[ -n "$ADMIN_PW" ] || { echo "GRAFANA_ADMIN_PASSWORD is empty: run make obs-keys"; exit 1; }
+[ -n "$TOKEN" ] || { echo "METRICS_TOKEN is empty: run make obs-keys and recreate app/horizon/reverb/scheduler"; exit 1; }
+fail=0
+bad() { echo "   FAIL: $*"; fail=1; }
+
+echo "== 1) Grafana up, provisioning clean, dashboards + datasources present"
+for i in $(seq 1 60); do
+  if curl -sf "$GRAFANA/api/health" >/dev/null 2>&1; then break; fi
+  sleep 2; [ "$i" -lt 60 ] || { bad "Grafana did not answer on $GRAFANA within 120 s"; }
+done
+if $OBS logs --no-log-prefix --no-color grafana 2>/dev/null | grep -iE 'provisioning' | grep -iE 'level=(error|crit)' | head -5 | grep -q .; then
+  $OBS logs --no-log-prefix --no-color grafana | grep -iE 'provisioning' | grep -iE 'level=(error|crit)' | head -5
+  bad "Grafana provisioning logged errors"
+else
+  echo "   OK: no provisioning errors in the Grafana log"
+fi
+dash="$(curl -sf -u "admin:${ADMIN_PW}" "$GRAFANA/api/search?type=dash-db&tag=aghigh" || echo '[]')"
+for uid in aghigh-api aghigh-db aghigh-redis aghigh-queues aghigh-websocket aghigh-orders; do
+  printf '%s' "$dash" | grep -q "\"uid\":\"$uid\"" && echo "   OK: dashboard $uid" || bad "dashboard $uid missing"
+done
+ds="$(curl -sf -u "admin:${ADMIN_PW}" "$GRAFANA/api/datasources" || echo '[]')"
+for uid in prometheus loki; do
+  printf '%s' "$ds" | grep -q "\"uid\":\"$uid\"" && echo "   OK: datasource $uid" || bad "datasource $uid missing"
+done
+
+echo "== 2) /internal is denied at the edge, reachable by Prometheus on the backend network"
+code="$(curl -s -o /dev/null -w '%{http_code}' "$EDGE/internal/metrics")"
+[ "$code" != "200" ] && echo "   OK: edge without token -> $code" || bad "edge served /internal/metrics without a token"
+code="$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $TOKEN" "$EDGE/internal/metrics")"
+[ "$code" != "200" ] && echo "   OK: edge WITH valid token -> $code (Traefik deny-all)" || bad "edge served /internal/metrics with the token: the Traefik internal-deny router is not working"
+code="$(curl -s -o /dev/null -w '%{http_code}' "$EDGE/internal/anything")"
+[ "$code" != "200" ] && echo "   OK: edge /internal/anything -> $code" || bad "/internal/anything reachable"
+if $OBS exec -T prometheus wget -qO- --header="Authorization: Bearer $TOKEN" http://app:8000/internal/metrics 2>/dev/null | grep -q '^aghigh_metrics_'; then
+  echo "   OK: prometheus container reads app:8000/internal/metrics with the token"
+else
+  bad "prometheus container cannot read app:8000/internal/metrics (token mismatch? run make obs-keys and recreate app)"
+fi
+if $OBS exec -T prometheus wget -qO- http://app:8000/internal/metrics 2>/dev/null | grep -q '^aghigh_metrics_'; then
+  bad "app:8000/internal/metrics answered WITHOUT a token"
+else
+  echo "   OK: app:8000/internal/metrics refuses a missing token"
+fi
+up="$(curl -s "$PROM/api/v1/query?query=up%7Bjob%3D%22app%22%7D" | grep -o '"value":\[[^]]*\]' | head -1)"
+printf '%s' "$up" | grep -q '"1"' && echo "   OK: Prometheus target app is up ($up)" || bad "Prometheus target app is not up: $up"
+
+if [ "${OBS_SKIP_TRAFFIC:-0}" != "1" ]; then
+  echo "== 3) traffic burst (make k6 s=smoke, make verify-chat), then wait one scrape interval"
+  make k6 s=smoke || bad "make k6 s=smoke failed"
+  make verify-chat || bad "make verify-chat failed"
+  sleep 20
+else
+  echo "== 3) traffic burst skipped (OBS_SKIP_TRAFFIC=1)"
+fi
+
+echo "== 4) every PromQL query of dashboards + rules against Prometheus (empty only if allowlisted)"
+$DC exec -T app php scripts/obs-query-check.php || bad "query check failed (see above)"
+
+echo "== 5) inventory of this host (docs/perf/obs-inventory.txt)"
+mkdir -p docs/perf
+{
